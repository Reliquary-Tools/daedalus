{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Daedalus",
  "version": "0.1.0",
  "identifier": "com.reliquary.daedalus",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "beforeBuildCommand": "npm run build:frontend",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Daedalus",
        "label": "main",
        "width": 1180,
        "height": 780,
        "minWidth": 940,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Reliquary",
    "targets": ["msi"],
    "icon": ["icons/icon.ico"]
  }
}
